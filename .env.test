# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# the test database; dama/doctrine-test-bundle appends its own suffix per worker
DATABASE_URL="postgresql://app:app@database:5432/app_test?serverVersion=16&charset=utf8"

# messages run inline in tests, so no worker is needed
MESSENGER_TRANSPORT_DSN=sync://
