# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# doctrine.yaml adds the "_test" suffix in the test env, so this runs against app_test
DATABASE_URL="postgresql://app:app@database:5432/app?serverVersion=16&charset=utf8"

# messages run inline in tests, so no worker is needed
MESSENGER_TRANSPORT_DSN=sync://
